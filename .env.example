# Supabase Configuration
# Required: Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Required: Supabase Service Role Key (used ONLY server-side for lead insertion & retries)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend Email Configuration
# Required: Resend API Key for sending notifications
RESEND_API_KEY=re_your_api_key_here
# Optional: Receiving inbox for new lead notifications
LEAD_NOTIFICATION_EMAIL=hello@solutionstudio.bd
# Optional: Verified sender email configured in Resend
LEAD_NOTIFICATION_FROM=Solution Studio <hello@solutionstudio.bd>

# Cloudflare Turnstile Spam Protection
# Public Site Key for client-side widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
# Secret Key for server-side verification in /api/submit-lead
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# Cron Secret for automated failed lead retries
CRON_SECRET=your_cron_secret_random_hex_string

# Analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

