# ==========================================
# Solution Studio Production Environment Variables
# ==========================================

# 1. Cloudflare Turnstile Bot Protection
# In production, obtain these from Cloudflare Dashboard -> Turnstile
# For local testing, use Cloudflare's official test keys:
# Site Key (always passes): 1x00000000000000000000AA
# Secret Key (always passes): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 2. Supabase Enterprise Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# 3. Resend Email Dispatcher
RESEND_API_KEY=re_...
LEAD_NOTIFICATION_EMAIL=sales@solutionstudio.bd
LEAD_NOTIFICATION_FROM=Solution Studio <sales@solutionstudio.bd>
RESEND_WEBHOOK_SECRET=whsec_...

# 4. Security & Idempotency Salt
CRON_SECRET=your-random-cron-salt-secret

# 5. Microsoft Clarity Web Analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

